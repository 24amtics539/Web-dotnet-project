@model RegisterViewModel
@{
    ViewData["Title"] = "Create Student Account";
}

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="logo-badge" style="width: 46px; height: 46px; border-radius: 14px;">
        <i data-lucide="graduation-cap" style="width: 24px; height: 24px;"></i>
      </div>
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join CampusDeadline to master your academic schedule</p>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post" class="auth-form" id="register-form">
      @Html.AntiForgeryToken()

      <div asp-validation-summary="ModelOnly" class="flash-banner error" style="margin-bottom: 14px;"></div>

      <div class="form-group">
        <label asp-for="Name" class="form-label">Full Name</label>
        <input asp-for="Name" class="form-input" placeholder="e.g. Alex Morgan" autofocus>
        <span asp-validation-for="Name" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <div class="form-group">
        <label asp-for="Email" class="form-label">College Email Address</label>
        <input asp-for="Email" class="form-input" placeholder="student@university.edu">
        <span asp-validation-for="Email" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <div class="form-group">
        <label asp-for="Password" class="form-label">Password</label>
        <div class="input-password-wrapper">
          <input asp-for="Password" class="form-input" placeholder="At least 6 characters">
          <button type="button" class="btn-toggle-pwd" data-target="Password" aria-label="Toggle password visibility">
            <i data-lucide="eye"></i>
          </button>
        </div>
        <span asp-validation-for="Password" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <div class="form-group">
        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
        <div class="input-password-wrapper">
          <input asp-for="ConfirmPassword" class="form-input" placeholder="Re-enter password">
          <button type="button" class="btn-toggle-pwd" data-target="ConfirmPassword" aria-label="Toggle password visibility">
            <i data-lucide="eye"></i>
          </button>
        </div>
        <span asp-validation-for="ConfirmPassword" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-prominent" id="btn-submit-register">
        <span>Complete Registration</span>
        <i data-lucide="arrow-right"></i>
      </button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login">Sign in here</a>
    </div>
  </div>
</div>
