@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="logo-badge" style="width: 46px; height: 46px; border-radius: 14px;">
        <i data-lucide="calendar-check" style="width: 24px; height: 24px;"></i>
      </div>
      <h1 class="auth-title">Welcome Back</h1>
      <p class="auth-subtitle">Sign in to manage your campus tasks &amp; academic deadlines</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" id="login-form">
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="ReturnUrl" />

      <div asp-validation-summary="ModelOnly" class="flash-banner error" style="margin-bottom: 14px;"></div>

      <div class="form-group">
        <label asp-for="Email" class="form-label">College Email Address</label>
        <input asp-for="Email" class="form-input" placeholder="student@university.edu" autofocus>
        <span asp-validation-for="Email" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <div class="form-group">
        <label asp-for="Password" class="form-label">
          <span>Password</span>
        </label>
        <div class="input-password-wrapper">
          <input asp-for="Password" class="form-input" placeholder="••••••••••••">
          <button type="button" class="btn-toggle-pwd" data-target="Password" aria-label="Toggle password visibility">
            <i data-lucide="eye"></i>
          </button>
        </div>
        <span asp-validation-for="Password" style="color: var(--color-danger); font-size: 0.78rem;"></span>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-prominent" id="btn-submit-login">
        <span>Sign In to Dashboard</span>
        <i data-lucide="arrow-right"></i>
      </button>
    </form>

    <div class="auth-footer">
      Don't have an account yet? <a href="/register">Create an account</a>
    </div>
  </div>
</div>
